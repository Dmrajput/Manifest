PORT=5000
NODE_ENV=development

# MongoDB (Atlas or local)
MONGODB_URI=mongodb://127.0.0.1:27017/manifestly

# Supabase Auth JWT verification (required for /users/me)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_JWT_SECRET=YOUR_JWT_SECRET

# OpenAI (never expose to mobile)
OPENAI_API_KEY=sk-your-key
OPENAI_MODEL=gpt-4o-mini
AI_AFFIRMATIONS_MOCK=0
AI_FREE_DAILY_LIMIT=3
AI_PREMIUM_DAILY_LIMIT=20

# CORS — comma-separated origins, or * for local only
CORS_ORIGIN=*

# Rate limits
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
