PORT=5000
NODE_ENV=development

# MongoDB Atlas — database name should be `manifestly` (created in Atlas)
# Example: mongodb+srv://USER:PASSWORD@cluster.mongodb.net/manifestly?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/manifestly

# Supabase Auth — set URL + anon/publishable key (validates tokens via Auth API)
# and/or JWT Secret from Project Settings → API (local HS256 verify)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_JWT_SECRET=YOUR_JWT_SECRET

# Google AI Studio (Gemini) — primary AI provider
GOOGLE_AI_API_KEY=YOUR_GOOGLE_AI_STUDIO_KEY
GOOGLE_AI_MODEL=gemini-3.5-flash
AI_AFFIRMATIONS_MOCK=0
AI_COACH_MOCK=0
AI_FREE_DAILY_LIMIT=3
AI_PREMIUM_DAILY_LIMIT=20

# Optional OpenAI (legacy, unused when Google AI is configured)
# OPENAI_API_KEY=sk-your-key
# OPENAI_MODEL=gpt-4o-mini

# Cloudflare R2 — vision board image uploads (preferred when set)
R2_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
R2_BUCKET_NAME=manifest-uploads
R2_VISION_PREFIX=vision
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
# Optional override:
# R2_S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com

# CORS — comma-separated origins, or * for local only
CORS_ORIGIN=*

# Rate limits
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Razorpay — premium subscriptions (live or test keys from Razorpay Dashboard)
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET
# Premium pricing (charged via Razorpay — amounts must match order creation)
# Use INR for rupees, or PAISE for exact paise (₹1 = 100 paise). PAISE overrides INR if both set.
PREMIUM_MONTHLY_INR=1
# PREMIUM_MONTHLY_PAISE=100
PREMIUM_YEARLY_INR=699
# PREMIUM_YEARLY_PAISE=69900
# Optional: PREMIUM_MONTHLY_DAYS=30  PREMIUM_YEARLY_DAYS=365

# Public API URL for Razorpay web checkout (register this domain in Razorpay Dashboard)
# Production: https://manifestly-api.onrender.com
# Local phone (match EXPO_PUBLIC_API_URL host, no /api/v1): http://YOUR_LAN_IP:5000
# In development the API also builds checkout URLs from the incoming request host.
API_PUBLIC_URL=http://127.0.0.1:5000

# Whitelisted Razorpay checkout origin (HTTPS). When set, WebView loads checkout from this host
# even if the API runs locally. Must use the same SUPABASE_JWT_SECRET on that host.
CHECKOUT_PUBLIC_URL=https://manifestly-api.onrender.com

# Dev-only: allow POST /subscriptions/sandbox in production (default: blocked)
# ALLOW_SANDBOX_ENTITLEMENTS=0
